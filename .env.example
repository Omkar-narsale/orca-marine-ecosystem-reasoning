# ==============================================================================
# ORCA Marine Ecosystem Intelligence Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` and fill in your API credentials.

# ------------------------------------------------------------------------------
# 1. LLM & Conversational Synthesis Configuration (Groq & Server-Side AI)
# ------------------------------------------------------------------------------
# Provider options: "groq", "deterministic_fallback", "openai", "gemini", "anthropic"
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# Primary Groq API Key (Get your free key from https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Generic LLM API Key (Fallback / Alternative providers)
LLM_API_KEY=

# ------------------------------------------------------------------------------
# 2. Authoritative Marine, Satellite & Earth Observation Credentials
# ------------------------------------------------------------------------------
# ISRO / MOSDAC Ocean Colour Monitor (OCM-3) API Token (from https://mosdac.gov.in)
MOSDAC_API_TOKEN=your_mosdac_token_here

# ISRO / NRSC Bhuvan Geospatial API Token (from https://bhuvan.nrsc.gov.in)
BHUVAN_API_TOKEN=your_bhuvan_token_here

# ------------------------------------------------------------------------------
# 3. Official Scientific Endpoints (Zero-Fabrication Live Data)
# ------------------------------------------------------------------------------
INCOIS_BASE_URL=https://incois.gov.in
INCOIS_OSF_URL=https://incois.gov.in/oceanservices/osfforecast.jsp
INCOIS_PFZ_URL=https://incois.gov.in/MarineFisheries/PfzAdvisory
INCOIS_ERDDAP_URL=https://erddap.incois.gov.in/erddap

IMD_API_BASE_URL=https://api.imd.gov.in/public
IMD_PUBLIC_URL=https://api.imd.gov.in/public/index.php

MOSDAC_BASE_URL=https://www.mosdac.gov.in
MOSDAC_API_DOCS=https://mosdac.gov.in/downloadapi-manual

GIS_CADASTRE_URL=https://hydro-india.nic.in
BHUVAN_API_URL=https://bhuvan-app1.nrsc.gov.in/api

# ------------------------------------------------------------------------------
# 4. Operational Marine Bounding Box (Default: Maharashtra Coastal Shelf)
# ------------------------------------------------------------------------------
DEFAULT_MIN_LAT=18.0
DEFAULT_MAX_LAT=20.0
DEFAULT_MIN_LON=71.5
DEFAULT_MAX_LON=73.5

# ------------------------------------------------------------------------------
# 5. Timeouts, Circuit Breakers & Cache Lifecycles
# ------------------------------------------------------------------------------
HTTP_TIMEOUT_SECONDS=10.0
WEATHER_CACHE_TTL_SECONDS=600
OCEAN_FORECAST_CACHE_TTL_SECONDS=1800
STATIC_CACHE_TTL_SECONDS=86400

MAX_AGENT_STEPS=8
MAX_TOOL_CALLS_PER_AGENT=6
AGENT_TIMEOUT_SECONDS=12.0
MAX_RETRY_LIMIT=2

# ------------------------------------------------------------------------------
# 6. Persistent Database Configuration (PostgreSQL / SQLite via SQLAlchemy)
# ------------------------------------------------------------------------------
# Default: local async SQLite file (zero-config). For PostgreSQL in production, use:
# DATABASE_URL=postgresql+asyncpg://orca_user:secure_password@localhost:5432/orca_marine
DATABASE_URL=sqlite+aiosqlite:///./orca_marine.db

# ------------------------------------------------------------------------------
# 7. Frontend & API Communication
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000/api

